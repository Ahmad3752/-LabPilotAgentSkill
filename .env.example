# LabPilot needs NO API keys. These optional, non-secret settings override defaults.
# Copy to .env only if your tooling loads it; LabPilot itself reads plain environment variables.

# Where LabPilot keeps user-level config (default: %APPDATA%\labpilot, ~/Library/Application Support/labpilot, ~/.config/labpilot)
# LABPILOT_CONFIG_DIR=

# Set to 0 to silence progress lines on stderr
# LABPILOT_PROGRESS=1

# Keep the Colab CLI session after execution (default: LabPilot stops sessions it created)
# LABPILOT_KEEP_SESSION=1

# Opt-in real Colab smoke test (uses YOUR Colab account and compute)
# LABPILOT_COLAB_SMOKE=1
